    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.10",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
